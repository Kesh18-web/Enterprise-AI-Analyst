# Frontend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development.
# In Railway, set these as Service Environment Variables.

# The deployed backend API URL.
# In Railway: set this to your backend service URL BEFORE building the frontend.
# Example: NEXT_PUBLIC_API_URL=https://enterprise-ai-analyst-backend.up.railway.app
#
# IMPORTANT: NEXT_PUBLIC_* variables are baked into the JS bundle at BUILD TIME.
# If you change this value in Railway, the frontend service must be redeployed.
NEXT_PUBLIC_API_URL=http://localhost:8000
